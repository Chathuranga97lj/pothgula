# SITE_ADDRESS is a domain name (library.example.lk) for automatic, free HTTPS,
# or ":80" for plain HTTP on a library network with no domain. See docs/setup.md.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	handle /api/* {
		# The largest upload is the catalogue import (5 MB).
		request_body {
			max_size 6MB
		}
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Built files carry a content hash in their names, so they never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
