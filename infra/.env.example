# Copy to infra/.env and fill in. Keep .env private: it holds the database password.

# The address people type. A domain name pointed at this server gives free,
# automatic HTTPS (library.example.lk). On a library network with no domain,
# use :80 for plain HTTP, reached by the server's IP address.
SITE_ADDRESS=:80

# The database password: letters and digits only, at least 24 of them.
# One way to make one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The nightly backup time, Colombo time (24-hour HH:MM), and how many to keep.
BACKUP_AT=01:30
BACKUP_KEEP=30

# Ports on this server. Change only if something else already uses them.
HTTP_PORT=80
HTTPS_PORT=443

# Shown on the health check; set when installing a tagged release.
POTHGULA_VERSION=0.1.0
