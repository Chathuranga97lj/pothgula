{
  "name": "pothgula",
  "private": true,
  "description": "Free and open-source lending and membership system for a multi-branch library.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @pothgula/shared build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm build && pnpm --filter @pothgula/e2e e2e",
    "screenshots": "pnpm build && pnpm --filter @pothgula/e2e screenshots",
    "db:up": "docker compose -f infra/compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
